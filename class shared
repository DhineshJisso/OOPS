class Shared {
    int number;
    boolean available = false;

    // Producer method
    synchronized void produce(int number) {
        try {
            while (available) {
                wait();
            }

            this.number = number;
            System.out.println("Produced: " + number);

            available = true;
            notify();

        } catch (InterruptedException e) {
            System.out.println(e);
        }
    }

    // Consumer method
    synchronized void consume() {
        try {
            while (!available) {
                wait();
            }

            System.out.println("Consumed: " + number);

            available = false;
            notify();

        } catch (InterruptedException e) {
            System.out.println(e);
        }
    }
}

// Producer Thread
class Producer extends Thread {
    Shared shared;

    Producer(Shared shared) {
        this.shared = shared;
    }

    public void run() {
        for (int i = 1; i <= 5; i++) {
            shared.produce(i);
        }
    }
}

// Consumer Thread
class Consumer extends Thread {
    Shared shared;

    Consumer(Shared shared) {
        this.shared = shared;
    }

    public void run() {
        for (int i = 1; i <= 5; i++) {
            shared.consume();
        }
    }
}

// Main Class
public class Main {
    public static void main(String[] args) {

        Shared shared = new Shared();

        Producer p = new Producer(shared);
        Consumer c = new Consumer(shared);

        p.start();
        c.start();
    }
}
